{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["STANDALONE"]
    },
    "developer#build": {
      "cache": false,
      "dependsOn": ["@monerium/sdk#build", "@monerium/openapi#build"],
      "outputs": ["docs/packages/**"]
    },
    "clean": {
      "cache": false
    },
    "lint": {},
    "lint:style": {},
    "pub:pre": {
      "dependsOn": ["build"]
    },
    "start": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "test:watch": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
