{
  "name": "partner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsx server/index.ts\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "lint": "eslint .",
    "clean": "rm -rf dist dist-server node_modules .turbo"
  },
  "dependencies": {
    "@monerium/sdk": "workspace:latest",
    "@reown/appkit": "^1.8.15",
    "@reown/appkit-adapter-ethers": "^1.8.15",
    "ethers": "^6.16.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "20.19.33",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "tsx": "latest",
    "typescript": "5.7.3",
    "vite": "latest"
  }
}
